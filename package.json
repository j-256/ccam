{
  "name": "ccam-monorepo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w packages/sdk && npm run build -w packages/cli",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "test": "npm run check:docs-cover && npm run test --workspaces",
    "lint": "eslint packages/*/src",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "test:integration": "npm run test:integration -w packages/sdk",
    "preversion": "scripts/preversion.sh",
    "version": "node scripts/version-sync.mjs",
    "postversion": "scripts/postversion.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
