{
  "name": "ccam-monorepo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w packages/sdk && npm run build -w packages/cli",
    "test": "npm run test --workspaces",
    "lint": "eslint packages/*/src",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "test:integration": "npm run test:integration -w packages/sdk",
    "preversion": "scripts/preversion.sh",
    "version": "node scripts/version-sync.mjs",
    "postversion": "scripts/postversion.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
