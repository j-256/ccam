{
  "name": "@j-256/ccam",
  "version": "1.1.0",
  "description": "CLI for the Salesforce Commerce Cloud Account Manager API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ccam": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ccam-sdk": "1.1.0",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "open": "^11.0.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-256/ccam.git"
  },
  "bugs": {
    "url": "https://github.com/j-256/ccam/issues"
  },
  "homepage": "https://github.com/j-256/ccam#readme",
  "keywords": [
    "salesforce",
    "commerce-cloud",
    "sfcc",
    "account-manager",
    "am",
    "demandware",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0"
  }
